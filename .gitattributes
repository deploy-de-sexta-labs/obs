# Normalização de finais de linha.
# O repositório guarda LF e o checkout também usa LF, exceto scripts do Windows.
* text=auto eol=lf

# Arquivos binários: não normalizar nem tentar gerar diff.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.bmp    binary
*.ico    binary
*.icns   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.7z     binary
*.tar    binary
*.mp3    binary
*.wav    binary
*.flac   binary
*.mp4    binary
*.mov    binary
*.mkv    binary

# Binários dos sidecars (ffmpeg, mediamtx, livekit) e bibliotecas nativas.
*.exe    binary
*.dll    binary
*.so     binary
*.dylib  binary
*.node   binary

# Scripts de Windows usam CRLF.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Scripts de Unix usam LF.
*.sh     text eol=lf
*.bash   text eol=lf
*.zsh    text eol=lf
